[Unit]
Description=Mindscape-AI API (FastAPI)
Wants=network-online.target
After=network-online.target

[Container]
# Built from: [`Dockerfile.mindscape-ai-api`](Dockerfile.mindscape-ai-api:1)
Image=localhost/mindscape-ai-api:latest
ContainerName=mindscape-ai-api

# API listens on 8000 in-container; publish to host 8011
PublishPort=8011:8000

# Defaults used by CMD in the image
Environment=MINDSCAPE_HOST=0.0.0.0
# IMPORTANT: this is the *container* port; keep it aligned with Dockerfile EXPOSE (8000).
Environment=MINDSCAPE_PORT=8000

# Networking notes:
# - Inside a container, "localhost" refers to the container itself, NOT the host.
# - In this deployment, Supabase and Qdrant run on the host and are reachable via:
#   host.containers.internal:<port>
#
# Supabase: ensure the API uses a URL reachable from inside the container.
# SupabaseSettings prefers SUPABASE_URL first, so override it here.
Environment=SUPABASE_URL=http://host.containers.internal:8000

# Mem0/Qdrant: point mem0 to host Qdrant (avoid default localhost:6333 inside container).
Environment=MEM0_VECTOR_PROVIDER=qdrant
Environment=MEM0_QDRANT_HOST=host.containers.internal
Environment=MEM0_QDRANT_PORT=6333

# Mount the host ConPort DB into the container so UI/API reflect local edits.
# This repo is copied into /workspace in the image, so mount over that path.
Volume=/home/pwp/srv/apps/mindscape-ai/context_portal:/workspace/context_portal:Z

# Path mapping:
# - Supabase registry stores host paths like /home/pwp/srv/apps/mindscape-ai
# - API runtime needs to access the same project at /workspace
# Used by root_path-based checks (has_conport) and ConPort app_id resolution.
#
# Use the simple key=value pair format to avoid JSON quoting/escaping issues in quadlet.
Environment=MINDSCAPE_PATH_MAP=/home/pwp/srv/apps/mindscape-ai=/workspace

# Mount managed app roots so the API can resolve per-app ConPort DBs (has_conport check + ConPort routes).
# Needed for Supabase registry entries whose root_path points into /home/pwp/srv/apps/* (e.g. model-proxy).
Volume=/home/pwp/srv/apps:/home/pwp/srv/apps:Z
Volume=/home/pwp/srv/mcps:/home/pwp/srv/mcps:Z

# Mem0 defaults to OpenAI providers; mem0 initialization will fail unless OPENAI_API_KEY is set.
# To avoid committing secrets, put them in this optional file (note the leading '-' means "optional"):
#   mkdir -p ~/.config/mindscape-ai
#   printf 'OPENAI_API_KEY=sk-...\n' > ~/.config/mindscape-ai/mindscape-ai-api.env
#   chmod 600 ~/.config/mindscape-ai/mindscape-ai-api.env
EnvironmentFile=%h/.config/containers/systemd/.env
EnvironmentFile=%h/.config/containers/systemd/supabase.env
EnvironmentFile=%h/.config/containers/systemd/mindscape-ai.env

# Allow the browser-served UI to talk to this API (adjust to your deployment hostname)
# If you access the UI at http://ubuntu-01:8012, that origin must be present here.
Environment=MINDSCAPE_CORS_ORIGINS=http://127.0.0.1:8012,http://localhost:8012,http://ubuntu-01:8012

# Optional: enable write endpoints for Workbench mode (default is false)
# Environment=MINDSCAPE_WORKBENCH_WRITE=true

# Optional: enable Apps registry write endpoints (default is false)
Environment=MINDSCAPE_APPS_WRITE=true

# Optional: Supabase-backed app registry (recommended for multi-app)
# Environment=SUPABASE_URL=https://your-project.supabase.co
# Environment=SUPABASE_SERVICE_ROLE_KEY=...

# Optional: legacy/dev multi-app fallback (comma-separated host paths).
# If you use this, you likely also need Volume= mounts so the container can see those directories.
# Environment=MINDSCAPE_APP_ROOTS=/srv/apps/app1,/srv/apps/app2
# Volume=/srv/apps:/srv/apps:Z

# Read-only root filesystem is nice-to-have, but left off until we confirm no writes are needed.
# ReadOnly=true

[Service]
Restart=always
RestartSec=2

[Install]
WantedBy=default.target