[Unit]
Description=Mindscape-AI API (FastAPI)
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/mindscape-ai-api:latest
ContainerName=mindscape-ai-api
Network=host

# The API should bind to 8011 so Kong can use 8000
Environment=MINDSCAPE_HOST=0.0.0.0
Environment=MINDSCAPE_PORT=8011

# Kong will be on port 8100, so API correctly uses Supabase gateway
Environment=SUPABASE_URL=http://127.0.0.1:8100

# Qdrant is on host network, port 6333 (correct)
Environment=MEM0_VECTOR_PROVIDER=qdrant
Environment=MEM0_QDRANT_HOST=127.0.0.1
Environment=MEM0_QDRANT_PORT=6333

# Path maps & CORS origins
Environment=MINDSCAPE_PATH_MAP=/home/pwp/srv/apps/mindscape-ai=/workspace
Environment=MINDSCAPE_CORS_ORIGINS=http://127.0.0.1:8012,http://localhost:8012,http://ubuntu-01:8012
Environment=MINDSCAPE_APPS_WRITE=true

EnvironmentFile=/etc/containers/systemd/.env
EnvironmentFile=/etc/containers/systemd/supabase.env
EnvironmentFile=/etc/containers/systemd/mindscape-ai.env

# Workspace volumes
Volume=/home/pwp/srv/apps/mindscape-ai/context_portal:/workspace/context_portal:Z
Volume=/home/pwp/srv/apps:/home/pwp/srv/apps:Z
Volume=/home/pwp/srv/mcps:/home/pwp/srv/mcps:Z

[Service]
Restart=always
RestartSec=2

[Install]
WantedBy=default.target