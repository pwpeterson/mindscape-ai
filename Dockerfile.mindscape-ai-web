# syntax=docker/dockerfile:1
#
# Mindscape-AI Web container (SvelteKit)
#
# Notes:
# - This Dockerfile is intended for a SvelteKit production build that outputs a Node server in `build/`
#   (i.e. using @sveltejs/adapter-node instead of adapter-auto).
# - SvelteKit commonly keeps `@sveltejs/kit` in devDependencies, but the built Node server still
#   requires it at runtime. Therefore we reuse the full node_modules from the deps stage.
#
# Build:
#   podman build -t localhost/mindscape-ai-web:latest -f Dockerfile.mindscape-ai-web .
#
# Run (example):
#   podman run --rm -p 8012:8012 -e PUBLIC_MINDSCAPE_API_BASE=http://127.0.0.1:8011 localhost/mindscape-ai-web:latest
#
FROM node:22-alpine AS deps

WORKDIR /app/web

# Install dependencies (uses lockfile for repeatable builds)
COPY web/package.json web/package-lock.json ./
RUN npm ci

FROM deps AS build

# Copy source and build
COPY web/ ./
RUN npm run build

FROM node:22-alpine AS runner

WORKDIR /app/web

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8012

# Reuse node_modules from the deps stage (includes @sveltejs/kit runtime deps)
COPY --from=deps /app/web/node_modules ./node_modules
COPY web/package.json ./package.json

# Copy built server output
COPY --from=build /app/web/build ./build

EXPOSE 8012

# Healthcheck: verify the web server responds on the configured PORT.
# Uses Node's built-in fetch() (Node 22) with a short abort timeout.
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "const ac=new AbortController(); const t=setTimeout(()=>ac.abort(),2000); fetch('http://127.0.0.1:'+process.env.PORT+'/',{signal:ac.signal}).then(r=>{clearTimeout(t); process.exit(r.ok?0:1);}).catch(()=>process.exit(1));"

CMD ["node", "build"]